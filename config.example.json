{
  "ssh_server": "YOUR_PUBLIC_SERVER_IP",
  "ssh_user": "tunnel",
  "dash_repo": "D:\\Applications\\deepseek-harness",
  "dash_port": 3080,
  "dash_cmd": ["pnpm.cmd", "dsh", "web"],

  "poll_seconds": 4,
  "remote_poll_seconds": 20,
  "tcp_timeout": 0.8,
  "ssh_timeout": 10,
  "update_timeout": 1800,

  "local_name": "本机",
  "lab_name": "实验室",
  "ssh_name": "公网中转",

  "deployments": [
    {"name": "实验室服务器", "host": "YOUR_LAB_IP", "user": "YOUR_USER", "port": 22, "dsh_home": "~/.dsh"}
  ],

  "tunnels": [
    {
      "id": "tun_office_relay",
      "name": "在家访问中转正向隧道",
      "mode": "forward",
      "host": "YOUR_PUBLIC_SERVER_IP",
      "user": "tunnel",
      "ssh_port": 22,
      "forwards": [
        {"local_port": 8090, "remote_host": "127.0.0.1", "remote_port": 8090, "desc": "办公室 dsh GUI"}
      ],
      "auto_restart": true,
      "enabled": true
    },
    {
      "id": "tun_local_reverse",
      "name": "本机反向暴露隧道",
      "mode": "reverse",
      "host": "YOUR_PUBLIC_SERVER_IP",
      "user": "tunnel",
      "ssh_port": 22,
      "forwards": [
        {"local_port": 8091, "remote_host": "127.0.0.1", "remote_port": 3080, "desc": "本机 dsh -> 公网 :8091"}
      ],
      "auto_restart": true,
      "enabled": true
    }
  ],

  "tunnel_plans": [
    {
      "name": "默认方案",
      "tunnels": [
        {
          "id": "tun_office_relay",
          "name": "在家访问中转正向隧道",
          "mode": "forward",
          "host": "YOUR_PUBLIC_SERVER_IP",
          "user": "tunnel",
          "ssh_port": 22,
          "forwards": [
            {"local_port": 8090, "remote_host": "127.0.0.1", "remote_port": 8090, "desc": "办公室 dsh GUI"}
          ],
          "auto_restart": true,
          "enabled": true
        }
      ]
    }
  ],
  "tunnel_plans_active": "默认方案"
}