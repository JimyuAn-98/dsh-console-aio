# ── Python ──
__pycache__/
*.py[cod]
*.egg-info/

# ── 构建 / 打包产物 ──
build/
dist/
*.spec

# ── 本地日志 / 临时文件 ──
*.log
*.err
dsh-dash/

# ── pytest 临时产物 / 缓存(不入库)──
.pytest-tmp/
pytest-cache-files-*/
.pytest_cache/
tmp/

# ── 个人配置（内含你的服务器 IP/用户名，不入库）──
config.json

# ── 打包旧产物 / 零碎 ──
*.zip
Thumbs.db
.DS_Store
# ── 运行时状态（隧道 PID 轨道等）──
tunnel-pids.json

# ── 个人使用指南(含真实内网信息, 不入库) ──
dsh使用指南.txt
个人使用指南.txt

# 调研用的第三方仓库副本(不入库)
_research/

# 配置备份(含真实IP, 不入库)
config.json.bak

# PySide6 观感预览截图(临时, 不入库)
*_preview.png

# vscode相关
.vscode/

# GUI 渲染 dump 产物(tools/dump_ui.py 生成, 不入库)
dump_ui.json
dump_ui.xml
ui_dump/
